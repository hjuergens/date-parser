<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>de.juergens</groupId>
        <artifactId>date-parser</artifactId>
        <version>0.0.2-SNAPSHOT</version>
    </parent>

    <artifactId>date-rule-bison</artifactId>
    <version>0.0.1</version>
    <packaging>jar</packaging>

    <name>${project.artifactId}</name>

    <inceptionYear>2016</inceptionYear>

    <dependencies>
        <dependency>
            <groupId>org.testng</groupId>
            <artifactId>testng</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <profiles>
        <!--
          Active when /usr/bin/bison exists. With bison elsewhere:
          mvn -Pbison -Dbison.executable=/path/to/bison test
        -->
        <profile>
            <id>bison</id>
            <activation>
                <file>
                    <exists>/usr/bin/bison</exists>
                </file>
            </activation>
            <properties>
                <bison.executable>/usr/bin/bison</bison.executable>
                <bison.target>${project.build.directory}/generated-sources/bison</bison.target>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <artifactId>maven-antrun-plugin</artifactId>
                        <version>3.2.0</version>
                        <executions>
                            <execution>
                                <id>generate-sources</id>
                                <phase>generate-sources</phase>
                                <configuration>
                                    <target>
                                        <mkdir dir="${bison.target}/io/github/hjuergens/bison"/>
                                        <exec executable="${bison.executable}" failonerror="true">
                                            <arg value="${project.basedir}/src/main/resources/calc.y"/>
                                            <arg value="--output=${bison.target}/io/github/hjuergens/bison/Calc.java"/>
                                        </exec>
                                    </target>
                                </configuration>
                                <goals>
                                    <goal>run</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>build-helper-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>add-bison-source</id>
                                <phase>generate-sources</phase>
                                <goals>
                                    <goal>add-source</goal>
                                </goals>
                                <configuration>
                                    <sources>
                                        <source>${bison.target}</source>
                                    </sources>
                                </configuration>
                            </execution>
                            <!-- tests need the generated parser, so they only compile in this profile -->
                            <execution>
                                <id>add-bison-test-source</id>
                                <phase>generate-test-sources</phase>
                                <goals>
                                    <goal>add-test-source</goal>
                                </goals>
                                <configuration>
                                    <sources>
                                        <source>${project.basedir}/src/bison-test/java</source>
                                    </sources>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>


</project>
