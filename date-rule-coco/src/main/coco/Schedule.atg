/*
 * Shared "schedule" example (see examples/schedule.txt in the project root):
 *   2015-06-09 + 3M, 09.06.2015, (2015-01-15 : 1Q : 2015-12-31)
 * The grammar is LL(1): after the first number the separator selects the date notation,
 * after a complete date '+' or '-' starts a period.
 * The actions build a ScheduleSemantics.Rule, a function of base date and market that is evaluated later.
 */
import java.time.LocalDate;
import java.time.Period;
import java.time.temporal.TemporalAmount;
import java.util.ArrayList;
import java.util.List;

COMPILER Schedule

  /** the rule of the schedule; only meaningful when errors.count == 0 */
  public ScheduleSemantics.Rule rule;

  private final List<ScheduleSemantics.Expr> exprs = new ArrayList<>();

  // error recovery may still run semantic actions, so they must not fail on garbage
  private ScheduleSemantics.Expr date(int year, int month, int day) {
    try {
      return ScheduleSemantics.literal(LocalDate.of(year, month, day));
    } catch (java.time.DateTimeException e) {
      SemErr(e.getMessage());
      return ScheduleSemantics.BASE;
    }
  }

CHARACTERS
  digit = "0123456789".
  upper = "ABCDEFGHIJKLMNOPQRSTUVWXYZ".

TOKENS
  number = digit {digit}.
  pair = upper upper upper upper upper upper.   /* currency pair such as EURUSD */

IGNORE '\t' + '\r' + '\n'

PRODUCTIONS

  Schedule                                (. ScheduleSemantics.Expr d; .)
  = Range
  | Expr<out d>                           (. exprs.add(d); .)
    { "," Expr<out d>                     (. exprs.add(d); .)
    }                                     (. rule = ScheduleSemantics.list(exprs); .)
  .

  Range                                   (. ScheduleSemantics.Expr first, last; TemporalAmount step; .)
  = "(" Expr<out first> ":" Period<out step> ":" Expr<out last> ")"
                                          (. if (errors.count > 0) return;
                                             if (!ScheduleSemantics.isPositive(step)) SemErr("step must be positive: " + step);
                                             else rule = ScheduleSemantics.range(first, step, last); .)
  .

  Expr<out ScheduleSemantics.Expr d>      (. TemporalAmount p; String code; .)
  = Date<out d>
    { "+" Period<out p>                   (. d = ScheduleSemantics.plus(d, p); .)
    | "-" Period<out p>                   (. d = ScheduleSemantics.minus(d, p); .)
    | ">"
      ( "IMM"                             (. d = ScheduleSemantics.nextImm(d); .)
      | "SPOT"                            (. code = null; .)
        [ pair                            (. code = t.val; .)
        ]                                 (. d = ScheduleSemantics.spot(d, code); .)
      )
    }.

  Date<out ScheduleSemantics.Expr d>      (. int a, b, c; d = ScheduleSemantics.BASE; .)
  = "T"                                   /* the base date */
  | Number<out a>
    ( "-" Number<out b> "-" Number<out c> (. d = date(a, b, c); .)
    | "." Number<out b> "." Number<out c> (. d = date(c, b, a); .)
    | "/" Number<out b> "/" Number<out c> (. d = date(c, a, b); .)
    ).

  Period<out TemporalAmount p>            (. int n; p = Period.ZERO; .)
  = Number<out n>
    ( "D"                                 (. p = Period.ofDays(n); .)
    | "W"                                 (. p = Period.ofWeeks(n); .)
    | "M"                                 (. p = Period.ofMonths(n); .)
    | "Q"                                 (. p = Period.ofMonths(3 * n); .)
    | "Y"                                 (. p = Period.ofYears(n); .)
    | "B"                                 (. p = new ScheduleSemantics.BusinessDays(n); .)
    ).

  Number<out int n>                       (. n = 0; .)
  = number                                (. try { n = Integer.parseInt(t.val); } catch (NumberFormatException e) { SemErr("number too large"); } .)
  .

END Schedule.
