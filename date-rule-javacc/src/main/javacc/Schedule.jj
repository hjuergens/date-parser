/*
 * Shared "schedule" example (see examples/schedule.txt in the project root):
 *   2015-06-09 + 3M, 09.06.2015, (2015-01-15 : 1Q : 2015-12-31)
 * LL(1): no lookahead beyond the next token is needed.
 * The productions build a ScheduleSemantics.Rule, a function of base date and market that is evaluated later.
 */
options {
  LOOKAHEAD = 1;
}

PARSER_BEGIN(Schedule)

package io.github.hjuergens.parser;

import java.io.StringReader;
import java.time.LocalDate;
import java.time.temporal.TemporalAmount;
import java.util.ArrayList;
import java.util.List;
import io.github.hjuergens.parser.ScheduleSemantics.Rule;

/** Parser of the shared "schedule" example. */
public class Schedule {

  /**
   * The rule of a schedule; evaluate it with {@code rule.evaluate(new ScheduleSemantics.Context(base, market))}.
   *
   * @throws ParseException on a syntax error
   * @throws TokenMgrException on an unknown character
   * @throws java.time.DateTimeException on an invalid date
   */
  public static Rule parse(String text) throws ParseException {
    return new Schedule(new StringReader(text)).Input();
  }
}

PARSER_END(Schedule)

SKIP : { " " | "\t" | "\r" | "\n" }

TOKEN : {
  < NUM : (["0"-"9"])+ >
| < UNIT : ["D", "W", "M", "Q", "Y", "B"] >
| < PAIR : (["A"-"Z"]){6} >   // currency pair such as EURUSD
}

/** Root production. */
Rule Input() :
{ Rule rule; }
{
  ( rule = Range() | rule = Exprs() ) <EOF>
  { return rule; }
}

Rule Exprs() :
{ List<ScheduleSemantics.Expr> exprs = new ArrayList<ScheduleSemantics.Expr>(); ScheduleSemantics.Expr d; }
{
  d = Expr() { exprs.add(d); }
  ( "," d = Expr() { exprs.add(d); } )*
  { return ScheduleSemantics.list(exprs); }
}

Rule Range() :
{ ScheduleSemantics.Expr first, last; TemporalAmount step; }
{
  "(" first = Expr() ":" step = Period() ":" last = Expr() ")"
  { return ScheduleSemantics.range(first, step, last); }
}

/** periods are applied from left to right */
ScheduleSemantics.Expr Expr() :
{ ScheduleSemantics.Expr d; TemporalAmount p; Token pair; }
{
  d = Date()
  ( "+" p = Period() { d = ScheduleSemantics.plus(d, p); }
  | "-" p = Period() { d = ScheduleSemantics.minus(d, p); }
  | ">"
    ( "IMM" { d = ScheduleSemantics.nextImm(d); }
    | "SPOT" { pair = null; } ( pair = <PAIR> )? { d = ScheduleSemantics.spot(d, pair == null ? null : pair.image); }
    )
  )*
  { return d; }
}

ScheduleSemantics.Expr Date() :
{ int a, b, c; }
{
  "T" { return ScheduleSemantics.BASE; }   // the base date
| a = Number()
  ( "-" b = Number() "-" c = Number() { return ScheduleSemantics.literal(LocalDate.of(a, b, c)); }   // ISO
  | "." b = Number() "." c = Number() { return ScheduleSemantics.literal(LocalDate.of(c, b, a)); }   // German
  | "/" b = Number() "/" c = Number() { return ScheduleSemantics.literal(LocalDate.of(c, a, b)); }   // US
  )
}

TemporalAmount Period() :
{ int n; Token unit; }
{
  n = Number() unit = <UNIT>
  { return ScheduleSemantics.period(n, unit.image); }
}

int Number() :
{ Token t; }
{
  t = <NUM> { return Integer.parseInt(t.image); }
}
