// Shared "schedule" example (see examples/schedule.txt in the project root):
//   2015-06-09 + 3M, 09.06.2015, [2015-01-15 : 1Q : 2015-12-31]
// The same grammar runs with parser="lalr" and parser="earley".

?start: exprs

exprs: item ("," item)*

// 24 DEC IF MON TUE WED THU, IF {MON, TUE}: the date only on these weekdays
item: expr combine* _if?
    | pick (series | EVENT) shift* combine* _if? -> picked_item

// 5TH [SPOT : 1Q : ] > EOQ > 3RD WED IN MONTH: the 5th date after T of the item, 2ND LAST the second-to-last; the item
// starts with a series or an event, where several dates come from (and LAST MON MAY can't be read as the count)
pick: ORDINAL [LAST_WORD]
LAST_WORD: "LAST"

// A & B includes the dates of B, A \ B excludes them; sorted, without duplicates, left to right: each shift applies to
// everything on its left
combine: "&" operand shift*     -> include
       | "\\" operand shift*    -> exclude

operand: date                   -> single_operand
       | "{" expr ("," expr)* "}" -> set_operand

_if: "IF" (WEEKDAY+ | "{" WEEKDAY ("," WEEKDAY)* "}")

// [a : step : b] is start + k * step up to b, every day without a step; "]" at the start or "[" at the end leaves
// that endpoint out (ISO 80000-2); the shifts after a series apply to each element
series: start_bracket endpoint ":" period ":" [endpoint] end_bracket
      | start_bracket endpoint ":" endpoint end_bracket -> series_every_day

// an endpoint is one date, so it can't be a series: after the last ":" a "]" closes an open series
endpoint: single_date shift*
start_bracket: "[" -> start_in
             | "]" -> start_out
end_bracket: "]"   -> end_in
           | "["   -> end_out

// shifts are applied from left to right
expr: date shift*

shift: "+" period           -> plus
     | "-" period           -> minus
     | ">" "IMM"            -> imm
     | ">" "SPOT" [PAIR]    -> spot
     | ">" ROLL             -> roll
     | ">" "NEXT" [ORDINAL] anchor -> next
     | ">" "PREV" [ORDINAL] anchor -> prev
     | ">" count select "IN" PERIOD -> select
     | ">" "{" annual ("," annual)* "}" -> dates_in_year
     | "{" observe ("," observe)* "}" -> observance

observe: WEEKDAY "+" period -> observe_plus
       | WEEKDAY "-" period -> observe_minus

// > 3RD WED IN MONTH, > 2ND LAST BD IN MONTH: the n-th match in the period of the date, from its start or its end
count: ORDINAL              -> from_start
     | "LAST"               -> last
     | ORDINAL "LAST"       -> from_end

// the targets of NEXT; an annual date starting with LAST only in braces, as LAST also starts the count
?select: chosen
       | "{" target ("," target)* "}" -> any_of

?chosen: WEEKDAY            -> weekday
       | "BD"               -> business_day
       | "IMM"              -> imm_anchor
       | fixed_annual       -> annual_anchor
       | EVENT              -> event_anchor

// NEXT 3RD FRI: the third Friday; NEXT {MON, FRI}: the first of a set
?anchor: target
       | "{" target ("," target)* "}" -> any_of

?target: WEEKDAY            -> weekday
      | "BD"                -> business_day
      | "IMM"               -> imm_anchor
      | annual              -> annual_anchor
      | EVENT               -> event_anchor

?date: single_date
     | series               -> element

// a date that is not a series
?single_date: "T"           -> base
    | "TOM"                 -> tom
    | "SPOT" [PAIR]         -> spot_date
    | NUM "-" NUM "-" NUM   -> iso
    | NUM "." NUM "." NUM   -> german
    | NUM "/" NUM "/" NUM   -> us
    | annual                -> in_year
    | EVENT                 -> event

// dates that recur every year, evaluated in the year of the base date
?annual: fixed_annual
       | "LAST" WEEKDAY MONTH -> last_weekday

?fixed_annual: NUM MONTH    -> month_day
      | NUM WEEKDAY MONTH   -> nth_weekday
      | "EASTER"            -> easter
      | SEASON MONTH [ZONE] -> season
      | "SOLARTERM" NUM [ZONE] -> solar_term

period: NUM UNIT

NUM: /[0-9]+/
// 1ST, 2ND, 3RD, 4TH: before NUM, which would take the digits
ORDINAL.2: /[0-9]+(ST|ND|RD|TH)/
SEASON: "EQUINOX" | "SOLSTICE"
// the time zone of an equinox, solstice or solar term: UTC unless an offset follows
ZONE: /UTC[+-][0-9]+/
UNIT: /[DWMQHYB]/
// Gregorian, then Hijri (Umm al-Qura), Hebrew and Chinese months; ADARII before ADAR
MONTH: "JAN" | "FEB" | "MAR" | "APR" | "MAY" | "JUN" | "JUL" | "AUG" | "SEP" | "OCT" | "NOV" | "DEC"
     | "MUHARRAM" | "SAFAR" | "RABIALAWWAL" | "RABIALTHANI" | "JUMADAALULA" | "JUMADAALAKHIRA" | "RAJAB" | "SHABAN"
     | "RAMADAN" | "SHAWWAL" | "DHULQADAH" | "DHULHIJJAH"
     | "NISAN" | "IYAR" | "SIVAN" | "TAMMUZ" | "AV" | "ELUL" | "TISHRI" | "HESHVAN" | "KISLEV" | "TEVET" | "SHEVAT"
     | "ADARII" | "ADAR"
     | "ZHENGYUE" | "ERYUE" | "SANYUE" | "SIYUE" | "WUYUE" | "LIUYUE" | "QIYUE" | "BAYUE" | "JIUYUE" | "SHIYUE"
     | "DONGYUE" | "LAYUE"
// a named event such as @FOMC, declared with the context; the sigil keeps names apart from keywords and pairs
EVENT: /@[A-Z][A-Z0-9_]*/
WEEKDAY: "MON" | "TUE" | "WED" | "THU" | "FRI" | "SAT" | "SUN"
ROLL: "FOLLOWING" | "PRECEDING" | "MODFOLLOWING" | "BOW" | "EOW" | "BOM" | "EOM" | "BOQ" | "EOQ" | "BOH" | "EOH" | "BOY" | "EOY"
// the periods of a selection; WEEK is Monday to Sunday
PERIOD: "WEEK" | "MONTH" | "QUARTER" | "HALFYEAR" | "YEAR"
// currency pair such as EURUSD; the contextual lexer would also take a six-letter keyword after SPOT
PAIR: /(?!EASTER|SHABAN|TAMMUZ|TISHRI|KISLEV|SHEVAT|ADARII|SANYUE|LIUYUE|JIUYUE|SHIYUE)[A-Z]{6}/

%ignore /[ \t\r\n]+/
