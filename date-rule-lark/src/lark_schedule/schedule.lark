// Shared "schedule" example (see examples/schedule.txt in the project root):
//   2015-06-09 + 3M, 09.06.2015, (2015-01-15 : 1Q : 2015-12-31)
// The same grammar runs with parser="lalr" and parser="earley".

?start: range | exprs

exprs: item ("," item)*

// 24 DEC IF MON TUE WED THU: the date only on these weekdays
item: expr ("IF" WEEKDAY+)?

range: "(" expr ":" period ":" expr ")"

// shifts are applied from left to right
expr: date shift*

shift: "+" period           -> plus
     | "-" period           -> minus
     | ">" "IMM"            -> imm
     | ">" "SPOT" [PAIR]    -> spot
     | ">" ROLL             -> roll
     | ">" "NEXT" anchor    -> next
     | ">" "PREV" anchor    -> prev
     | "{" observe ("," observe)* "}" -> observance

observe: WEEKDAY "+" period -> observe_plus
       | WEEKDAY "-" period -> observe_minus

anchor: WEEKDAY             -> weekday
      | "BD"                -> business_day
      | "IMM"               -> imm_anchor
      | annual              -> annual_anchor
      | EVENT               -> event_anchor

date: "T"                   -> base
    | "TOM"                 -> tom
    | "SPOT" [PAIR]         -> spot_date
    | NUM "-" NUM "-" NUM   -> iso
    | NUM "." NUM "." NUM   -> german
    | NUM "/" NUM "/" NUM   -> us
    | annual                -> in_year
    | EVENT                 -> event

// dates that recur every year, evaluated in the year of the base date
annual: NUM MONTH           -> month_day
      | NUM WEEKDAY MONTH   -> nth_weekday
      | "LAST" WEEKDAY MONTH -> last_weekday
      | "EASTER"            -> easter

period: NUM UNIT

NUM: /[0-9]+/
UNIT: /[DWMQYB]/
// Gregorian, then Hijri (Umm al-Qura), Hebrew and Chinese months; ADARII before ADAR
MONTH: "JAN" | "FEB" | "MAR" | "APR" | "MAY" | "JUN" | "JUL" | "AUG" | "SEP" | "OCT" | "NOV" | "DEC"
     | "MUHARRAM" | "SAFAR" | "RABIALAWWAL" | "RABIALTHANI" | "JUMADAALULA" | "JUMADAALAKHIRA" | "RAJAB" | "SHABAN"
     | "RAMADAN" | "SHAWWAL" | "DHULQADAH" | "DHULHIJJAH"
     | "NISAN" | "IYAR" | "SIVAN" | "TAMMUZ" | "AV" | "ELUL" | "TISHRI" | "HESHVAN" | "KISLEV" | "TEVET" | "SHEVAT"
     | "ADARII" | "ADAR"
     | "ZHENGYUE" | "ERYUE" | "SANYUE" | "SIYUE" | "WUYUE" | "LIUYUE" | "QIYUE" | "BAYUE" | "JIUYUE" | "SHIYUE"
     | "DONGYUE" | "LAYUE"
// a named event such as @FOMC, declared with the context; the sigil keeps names apart from keywords and pairs
EVENT: /@[A-Z][A-Z0-9_]*/
WEEKDAY: "MON" | "TUE" | "WED" | "THU" | "FRI" | "SAT" | "SUN"
ROLL: "FOLLOWING" | "PRECEDING" | "MODFOLLOWING" | "BOM" | "EOM" | "BOY" | "EOY"
// currency pair such as EURUSD; the contextual lexer would also take a six-letter keyword after SPOT
PAIR: /(?!EASTER|SHABAN|TAMMUZ|TISHRI|KISLEV|SHEVAT|ADARII|SANYUE|LIUYUE|JIUYUE|SHIYUE)[A-Z]{6}/

%ignore /[ \t\r\n]+/
