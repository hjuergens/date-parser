/*
	filename   : schedule.grammar
	description: shared "schedule" example (see examples/schedule.txt in the project root)
	             2015-06-09 + 3M, 09.06.2015, (2015-01-15 : 1Q : 2015-12-31)
	             SableCC only builds the syntax tree, ScheduleEvaluator computes the dates.
*/

Package de.juergens.schedule;

Helpers
	digit = ['0' .. '9'];
	upper = ['A' .. 'Z'];

Tokens
	number = digit+;
	ordinal = digit+ ('ST' | 'ND' | 'RD' | 'TH');   /* 1ST, 2ND, 3RD, 4TH; the longer match wins over number */
	unit = 'D' | 'W' | 'M' | 'Q' | 'H' | 'Y' | 'B';
	imm = 'IMM';
	spot = 'SPOT';
	base = 'T';
	tom = 'TOM';
	next = 'NEXT';
	prev = 'PREV';
	bd = 'BD';
	last = 'LAST';
	if = 'IF';
	in = 'IN';
	period_word = 'WEEK' | 'MONTH' | 'QUARTER' | 'HALFYEAR' | 'YEAR';   /* the periods of a selection */
	/* Gregorian, then Hijri (Umm al-Qura), Hebrew and Chinese months; before pair, like easter */
	month = 'JAN' | 'FEB' | 'MAR' | 'APR' | 'MAY' | 'JUN' | 'JUL' | 'AUG' | 'SEP' | 'OCT' | 'NOV' | 'DEC'
		| 'MUHARRAM' | 'SAFAR' | 'RABIALAWWAL' | 'RABIALTHANI' | 'JUMADAALULA' | 'JUMADAALAKHIRA' | 'RAJAB' | 'SHABAN'
		| 'RAMADAN' | 'SHAWWAL' | 'DHULQADAH' | 'DHULHIJJAH'
		| 'NISAN' | 'IYAR' | 'SIVAN' | 'TAMMUZ' | 'AV' | 'ELUL' | 'TISHRI' | 'HESHVAN' | 'KISLEV' | 'TEVET' | 'SHEVAT'
		| 'ADAR' | 'ADARII'
		| 'ZHENGYUE' | 'ERYUE' | 'SANYUE' | 'SIYUE' | 'WUYUE' | 'LIUYUE' | 'QIYUE' | 'BAYUE' | 'JIUYUE' | 'SHIYUE'
		| 'DONGYUE' | 'LAYUE';
	weekday = 'MON' | 'TUE' | 'WED' | 'THU' | 'FRI' | 'SAT' | 'SUN';
	roll = 'FOLLOWING' | 'PRECEDING' | 'MODFOLLOWING' | 'BOW' | 'EOW' | 'BOM' | 'EOM' | 'BOQ' | 'EOQ' | 'BOH' | 'EOH' | 'BOY' | 'EOY';
	easter = 'EASTER';   /* before pair: on a match of the same length the earlier token wins */
	pair = upper upper upper upper upper upper;
	event = '@' upper (upper | digit | '_')*;   /* a named event such as @FOMC; the sigil keeps it apart from keywords */
	season = 'EQUINOX' | 'SOLSTICE';
	solarterm = 'SOLARTERM';
	zone = 'UTC' ('+' | '-') digit+;   /* the time zone of an equinox, solstice or solar term */
	gt = '>';
	l_brace = '{';
	r_brace = '}';
	plus = '+';
	minus = '-';
	dot = '.';
	slash = '/';
	comma = ',';
	colon = ':';
	l_bracket = '[';
	amp = '&';
	backslash = 92;   /* \ */
	r_bracket = ']';
	blank = (' ' | 9 | 10 | 13)+;

Ignored Tokens
	blank;

Productions
	schedule = item more_item*;

	more_item = comma item;

	/* 24 DEC IF MON TUE WED THU, IF {MON, TUE}: the date only on these weekdays */
	item = expr combine* condition?;

	/* A & B includes the dates of B, A \ B excludes them; the shifts after it apply to the result */
	combine
		= {include} amp operand shift*
		| {exclude} backslash operand shift*;

	/* a date, a series or a set of dates */
	operand
		= {single} date
		| {set} l_brace expr more_expr* r_brace;

	more_expr = comma expr;

	condition
		= {plain} if weekday+
		| {set} if l_brace weekday more_weekday* r_brace;

	more_weekday = comma weekday;

	/* [a : step : b], every day without a step; "]" at the start or "[" at the end leaves that endpoint out. A series
	   is a date with several values, like an event: the shifts after it apply to each element */
	series = start_bracket [first]:expr colon step? [last]:expr end_bracket;

	step = period colon;

	start_bracket
		= {closed} l_bracket
		| {open} r_bracket;

	end_bracket
		= {closed} r_bracket
		| {open} l_bracket;

	expr = date shift*;

	shift
		= {plus} plus period
		| {minus} minus period
		| {imm} gt imm
		| {spot} gt spot pair?
		| {roll} gt roll
		| {next} gt next ordinal? anchor   /* NEXT 3RD FRI: the third Friday */
		| {prev} gt prev ordinal? anchor
		| {select} gt count select in period_word   /* > 3RD WED IN MONTH, > 2ND LAST BD IN MONTH */
		| {dates_in_year} gt l_brace annual more_annual* r_brace   /* > {1 FEB, 1 MAY} */
		| {observance} l_brace observe more_observe* r_brace;

	observe
		= {plus} weekday plus period
		| {minus} weekday minus period;

	more_observe = comma observe;

	/* the n-th match in the period of the date, from its start or its end */
	count
		= {from_start} ordinal
		| {from_end} ordinal last
		| {last} last;

	/* the targets of NEXT; an annual date starting with LAST only in braces, as LAST also starts the count */
	select
		= {single} chosen
		| {set} l_brace target more_target* r_brace;

	/* NEXT {MON, FRI}: the nearest of a set */
	anchor
		= {single} target
		| {set} l_brace target more_target* r_brace;

	more_target = comma target;

	more_annual = comma annual;

	target
		= {chosen} chosen
		| {last} last weekday month;

	chosen
		= {weekday} weekday
		| {bd} bd
		| {imm} imm
		| {annual} fixed_annual
		| {event} event;

	date
		= {base} base
		| {tom} tom
		| {spot} spot pair?
		| {annual} annual
		| {event} event
		| {series} series
		| {iso} [year]:number [s1]:minus [month]:number [s2]:minus [day]:number
		| {german} [day]:number [s1]:dot [month]:number [s2]:dot [year]:number
		| {us} [month]:number [s1]:slash [day]:number [s2]:slash [year]:number;

	annual
		= {fixed} fixed_annual
		| {last} last weekday month;

	fixed_annual
		= {month_day} number month
		| {nth_weekday} number weekday month
		| {easter} easter
		| {season} season month zone?
		| {solar_term} solarterm number zone?;

	period = number unit;
