<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>de.juergens</groupId>
    <artifactId>date-parser</artifactId>
    <packaging>pom</packaging>
    <version>0.0.2-SNAPSHOT</version>
    <modules>
        <module>date-rule-antlr</module>
        <module>date-rule-combinators</module>
        <module>date-rule-coco</module>
        <module>date-rule-sablecc</module>
        <module>date-rule-javacc</module>
    	<!-- http://www2.cs.tum.edu/projects/cup/ -->
        <module>date-rule-cup-jflex</module>
	    <!-- https://www.gnu.org/software/bison -->
        <module>date-rule-bison</module>
        <!-- https://github.com/Engelberg/instaparse (Clojure) -->
        <module>date-rule-instaparse</module>
    </modules>
    <name>${project.artifactId}</name>
    <description>Date Parser - evaluating various technologies</description>
    <inceptionYear>2015</inceptionYear>

    <properties>
        <maven.compiler.release>17</maven.compiler.release>
        <scala.major.version>2.13</scala.major.version>
        <scala.version>2.13.18</scala.version>
        <scala.compat.version>2.13</scala.compat.version>
        <scalaCompatVersion>${scala.compat.version}</scalaCompatVersion>
        <encoding>UTF-8</encoding>
        <project.build.sourceEncoding>${encoding}</project.build.sourceEncoding>
        <project.reporting.outputEncoding>${encoding}</project.reporting.outputEncoding>
        <project.resources.sourceEncoding>${encoding}</project.resources.sourceEncoding>
        <github.global.server>github</github.global.server>
        <jacoco-maven-plugin.version>0.8.16</jacoco-maven-plugin.version>
        <scala-maven-plugin.version>4.10.0</scala-maven-plugin.version>
        <maven-checkstyle-plugin-version>3.6.0</maven-checkstyle-plugin-version>
        <!-- 3.6+ runs TestNG on the JUnit Platform and reads no TestNG suite XML files; modules select tests with includes -->
        <maven-surefire-plugin.version>3.6.1</maven-surefire-plugin.version>
        <maven-surefire-report-plugin-version>${maven-surefire-plugin.version}</maven-surefire-report-plugin-version>
        <slf4j.version>2.0.20</slf4j.version>
        <scalatest.version>3.2.20</scalatest.version>
        <specs2.version>4.23.0</specs2.version>
        <javadoc.opts>-Xdoclint:none</javadoc.opts>
    </properties>

    <!-- Licensing -->
    <licenses>
        <license>
            <name>The GNU Lesser General Public License, Version 3.0</name>
            <url>http://www.gnu.org/licenses/lgpl-3.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <organization>
        <name>Jürgens</name>
        <url>https://github.com/date-parser</url>
    </organization>

    <scm>
        <connection>scm:git:git://github.com/hjuergens/date-parser.git</connection>
        <developerConnection>scm:git:git@github.com:hjuergens/date-parser.git</developerConnection>
        <url>http://github.com/hjuergens/date-parser/</url>
    </scm>

    <!--repositories>
        <!repository>
            <id>oss.sonatype.org</id>
